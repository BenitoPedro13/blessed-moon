# Chrome Origin Trial token unlocking the experimental html-in-canvas API
# (ParticleScroll, DecryptReveal) for real visitors, no chrome://flags needed
# on their end. Origin-bound — must match the exact production origin
# (currently https://blessed-moon.vercel.app, see src/lib/site-config.ts).
# Register at https://developer.chrome.com/origintrials/#/view_trial/3478467762190286849
# See docs/tasks/TASK-html-in-canvas-origin-trial.md for details.
# Optional: the site works fine without it (graceful fallback), just without
# the native dissolve effect for visitors outside the trial.
ORIGIN_TRIAL_TOKEN_HTML_IN_CANVAS=

# Umami analytics (self-hosted). Tracking script requires the first two;
# adding the recorder src also enables session replay/heatmaps. All are
# only loaded in production builds (see src/app/layout.tsx). Sample
# rates/mask level/max duration are configured in the Umami dashboard, not here.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_RECORDER_SRC=

# Official agency channels, read server-side by /contact. The receiving inbox
# also appears as a direct-email link. Booking remains optional.
AGENCY_CONTACT_EMAIL=
AGENCY_BOOKING_URL=

# Server-only SMTP delivery. For Gmail: smtp.gmail.com, port 465, Gmail address
# for SMTP_USER and SMTP_FROM_EMAIL, and a Google App Password (not your account
# password). Keep the password in .env.local and your hosting settings only.
# Port 465 uses TLS; 587 and 2525 require STARTTLS. All fields are required.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
